# Maintainer: chromag316 <293010337+chromag316@users.noreply.github.com>
#
# Binary package built from the release's .deb. After a new release, run
# packaging/aur/update.sh <version> to set pkgver and the checksums, then publish.
pkgname=forever-addon-manager-bin
_name=forever-addon-manager
pkgver=1.1.0
pkgrel=1
pkgdesc="Small, fast addon manager for WoW Forever (CurseForge, Git and local folders)"
arch=('x86_64')
url="https://github.com/chromag316/forever-addon-manager"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme')
optdepends=('git: install addons from Git repositories')
provides=("$_name")
conflicts=("$_name")
options=('!strip' '!debug')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/chromag316/$_name/v$pkgver/LICENSE")
source_x86_64=("$_name-$pkgver.deb::$url/releases/download/v$pkgver/Forever-AddOn-Manager-$pkgver-Linux-amd64.deb")
sha256sums=('6e15f1c4af1971f236df237c60332221221338d5263cf6600e3354041dc25422')
sha256sums_x86_64=('702b44ab6219ea88db0bddc38bcc44b8e8a41e0ed1bd740041ae71b7a49a334b')

package() {
  # makepkg has already unpacked the .deb (an ar archive); the files are in data.tar.gz.
  bsdtar -xf data.tar.gz -C "$pkgdir"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
